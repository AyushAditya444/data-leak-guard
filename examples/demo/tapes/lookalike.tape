# Generated by `python -m examples.demo.build` from the narration timings.
Output build/demo/scenes/lookalike.mp4
Set FontSize 18
Set Width 1280
Set Height 600
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "python3 examples/demo/player.py lookalike --session examples/demo/session.json --at 0.0,8.967 --hold 12.97"
Enter
Sleep 1.0s
Show
Sleep 11.97s
