# Generated by `python -m examples.demo.build` from the narration timings.
Output build/demo/scenes/secret.mp4
Set FontSize 18
Set Width 1280
Set Height 600
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "python3 examples/demo/player.py secret --session examples/demo/session.json --at 0.0,6.173 --hold 11.22"
Enter
Sleep 1.0s
Show
Sleep 10.22s
