# Generated by `python -m examples.demo.build` from the narration timings.
Output build/demo/scenes/core.mp4
Set FontSize 18
Set Width 1280
Set Height 600
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "python3 examples/demo/player.py core --session examples/demo/session.json --at 0.0,6.666,14.099 --hold 23.05"
Enter
Show
Sleep 23.05s
