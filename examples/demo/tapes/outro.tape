# Generated by `python -m examples.demo.build` from the narration timings.
Output build/demo/scenes/outro.mp4
Set FontSize 18
Set Width 1280
Set Height 600
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "python3 examples/demo/player.py outro --session examples/demo/session.json --at 0.0 --hold 16.04"
Enter
Sleep 1.0s
Show
Sleep 15.04s
