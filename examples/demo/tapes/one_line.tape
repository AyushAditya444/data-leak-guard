# Generated by `python -m examples.demo.build` from the narration timings.
Output build/demo/scenes/one_line.mp4
Set FontSize 18
Set Width 1280
Set Height 600
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "python3 examples/demo/player.py one_line --session examples/demo/session.json --at 0.0 --hold 7.03"
Enter
Show
Sleep 7.03s
