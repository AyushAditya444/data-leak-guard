# Generated by `python -m examples.demo.build` from the narration timings.
Output build/demo/scenes/title.mp4
Set FontSize 18
Set Width 1280
Set Height 600
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "python3 examples/demo/player.py title --session examples/demo/session.json --at 0.0 --hold 6.78"
Enter
Show
Sleep 6.78s
